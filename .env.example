# ─────────────────────────────────────────────────────────────────────────────
# SOLEINDEX — affiliate configuration
#
# Copy this file to `.env.local` and fill in what you have. Everything here is
# OPTIONAL: with nothing set, the app runs exactly as it does now (real
# SuperKicks prices + plain "check price" deep-links). Add credentials to turn
# links into commission-earning links and to pull live Amazon prices.
#
# These are read at BUILD time (server-side), so set them in your Vercel project
# env vars too, then redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Affiliate link monetization (wraps outbound "Buy" / "Check price" links) ──

# Amazon Associates tracking id. Works immediately once you have an Associates
# account — does NOT require PA-API approval. India tags end in -21.
AMAZON_ASSOCIATE_TAG=

# Cuelinks channel id. One id monetizes Flipkart, AJIO, Nike, Myntra, etc. by
# wrapping the destination URL through a single redirect.
CUELINKS_CID=

# ── Live Amazon prices (Product Advertising API 5.0) ──
# Requires an approved Associates account + PA-API access (granted after ~3
# qualifying sales). When set, `node scripts/fetch-data.mjs` adds real Amazon
# prices to the catalogue. Leave blank to keep Amazon as a deep-link.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Optional PA-API overrides (defaults shown target the India marketplace)
# AMAZON_HOST=webservices.amazon.in
# AMAZON_REGION=eu-west-1
# AMAZON_MARKETPLACE=www.amazon.in
# AMAZON_SEARCH_INDEX=Fashion
